class DummyClassNameSeeder extends Seeder
{
    /**
     * Run the database seeds.
     *
     * @return void
     */
    public function run()
    {
        $records = [
            [
                'name' => 'DummyClassName',
                'created_by' => 1,
                'created_at' => now(config('constants.TIME_ZONE')),
